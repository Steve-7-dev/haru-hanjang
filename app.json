{
  "expo": {
    "name": "하루한장",
    "slug": "haru-hanjang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "haruhanjang",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.haruhanjang.ios",
      "infoPlist": {
        "NSCameraUsageDescription": "오늘의 한 장을 찍기 위해 카메라가 필요합니다.",
        "NSPhotoLibraryUsageDescription": "오늘의 한 장을 고르기 위해 사진 접근이 필요합니다.",
        "NSMicrophoneUsageDescription": "영상은 추후 지원 예정입니다."
      }
    },
    "android": {
      "package": "app.haruhanjang.android",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "오늘의 한 장을 고르기 위해 사진 접근이 필요합니다.",
          "cameraPermission": "오늘의 한 장을 찍기 위해 카메라가 필요합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0095F6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
